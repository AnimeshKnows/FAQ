# Copy to .env at the repo root before `docker compose up`
# Never commit real secrets.

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

APP_NAME=DevDocs RAG
DEBUG=false

# Fail startup without Groq when true (recommended in prod)
REQUIRE_GROQ_KEY=true
# Expose /docs and /openapi.json
DOCS_ENABLED=false
# Allow HTTP ingest / activate / backup / raw listing
INGEST_ENABLED=false
# Comma-separated frontend origins, or * for all
CORS_ORIGINS=*

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RETRIEVE_TOP_K=10
RERANK_TOP_K=5

# Host ports
FRONTEND_PORT=80
BACKEND_PORT=8000

# Redis (shared rate limits across backend replicas)
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_RETRIEVE=60/minute
RATE_LIMIT_INGEST=3/hour

# Keep N versioned indexes under vectorstore/versions/
INDEX_VERSION_KEEP=5
