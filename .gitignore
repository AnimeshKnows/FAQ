# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env

# Vector store & processed data (regenerable)
backend/vectorstore/**
!backend/vectorstore/.gitkeep
backend/data/processed/**
!backend/data/processed/.gitkeep

# Evaluation outputs & ephemeral reports (never commit)
evaluation/results/**
!evaluation/results/.gitkeep
evaluation/prod_test_report.md
**/prod_test_report.md
evaluation/**/*.zip

# Legacy Spline / unused scene assets (TunnelCanvas UI only)
*.splinecode
scene.splinecode
scene-clean.splinecode
frontend-legacy-spline/

# Local / generated frontend junk
frontend/metadata.json
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Caches & logs
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
npm-debug.log*
