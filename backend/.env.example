# Groq (required for generation)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# HuggingFace / models — keep everything on D:
HF_HOME=D:\HF_CACHE
TRANSFORMERS_CACHE=D:\HF_CACHE
SENTENCE_TRANSFORMERS_HOME=D:\HF_CACHE

# Embedding & reranker models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Retrieval defaults
RETRIEVE_TOP_K=10
RERANK_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# App
APP_NAME=DevDocs RAG
DEBUG=false
